{
  "scenarios": [
    {
      "id": "later-in-the-day",
      "about": "Offered Monday mornings; lead asks for later in the day",
      "contact": {
        "email": "sam@example.com",
        "readyToBook": true
      },
      "phoneOnFile": true,
      "offered": {
        "kind": "consult",
        "slots": [
          "2026-10-05 10:00",
          "2026-10-05 10:30",
          "2026-10-05 11:00"
        ],
        "text": "I have Monday, Oct 5 at 10:00 AM, 10:30 AM, or 11:00 AM. Which works best?"
      },
      "turns": [
        {
          "user": "Any time later in the day?",
          "expect": {
            "checksCalendar": true,
            "noBooking": true,
            "replyMatches": ["mon", "\\b(1[2]|[1-5])(:[0-5]\\d)?\\s?pm\\b"],
            "replyNotMatches": "\\b(sat|sun|tomorrow|today)",
            "noContactAsk": true
          }
        }
      ]
    },
