{
  "scenarios": [
    {
      "id": "new-lead-greeting",
      "about": "Fresh lead from a listing comment",
      "contact": {
        "targetLocation": null,
        "propertyType": null,
        "intent": null,
        "leadStatus": "New"
      },
      "property": "oak",
      "turns": [
        {
          "user": "Hi, I saw your post about 12 Oak St",
          "expect": {
            "noBooking": true,
            "replyNotMatches": "you'?re (all set|booked)"
          }
        }
      ]
    },
    {
      "id": "interested-open-house-opening",
      "about": "First message 'I am interested' on an open-house post: greet, ask how to help, no appointment times",
      "contact": { "leadStatus": "New", "intent": null, "targetLocation": null, "propertyType": null },
      "property": "openhouse",
      "turns": [
        {
          "user": "I am interested in this property",
          "expect": {
            "noBooking": true,
            "replyMatches": ["\\b(hi|hello|hey)\\b", "thank", "\\?"],
            "replyNotMatches": ["10:00|10:30|11:00", "availability"]
          }
        }
      ]
    },
    {
      "id": "interested-then-see-it",
      "about": "Opening, then they want to see it and name a day: times come with the day",
      "contact": { "leadStatus": "New", "intent": null, "targetLocation": null, "propertyType": null },
      "property": "oak",
      "turns": [
        {
          "user": "I am interested in this property",
          "expect": { "noBooking": true, "replyNotMatches": "\\d{1,2}:\\d{2}\\s*(am|pm)" }
        },
        {
          "user": "I'd like to see it Saturday morning",
          "expect": { "checksCalendar": true, "noBooking": true, "replyMatches": "sat|oct 3" }
        }
      ]
    },
    {
      "id": "first-message-asks-to-tour",
      "about": "First message already asks to tour this weekend: look up times right away",
      "contact": { "leadStatus": "New", "intent": null, "targetLocation": null, "propertyType": null },
      "property": "oak",
      "turns": [
        {
          "user": "Can I tour it this weekend?",
          "expect": { "checksCalendar": true, "noBooking": true, "replyMatches": ["sat|sun", "\\b(hi|hello|hey)\\b"] }
        }
      ]
    },
    {
      "id": "price-question",
      "about": "Simple listing question",
      "contact": {
        "email": "sam@example.com"
      },
      "phoneOnFile": true,
      "property": "oak",
      "turns": [
        {
          "user": "What's the asking price?",
          "expect": {
            "noBooking": true,
            "replyMatches": "650"
          }
        }
      ]
    },
    {
      "id": "email-only-reply",
      "about": "Lead shares email with no time pending; save it, don't book",
      "history": [
        [
          "user",
          "Looking to buy in Montclair"
        ],
        [
          "assistant",
          "Great! What's the best email and mobile for you?"
        ]
      ],
      "turns": [
        {
          "user": "sam@example.com",
          "expect": {
            "noBooking": true,
            "savesEmail": "sam@example.com",
            "replyNotMatches": "you'?re (all set|booked)"
          }
        }
      ]
    },
    {
      "id": "opt-out",
      "about": "STOP must unsubscribe",
      "turns": [
        {
          "user": "STOP",
          "expect": {
            "noBooking": true,
            "optedOut": true,
            "replyMatches": "unsubscribed"
          }
        }
      ]
    },
    {
      "id": "wants-a-person",
      "about": "Lead asks for a human",
      "contact": {
        "email": "sam@example.com"
      },
      "phoneOnFile": true,
      "turns": [
        {
          "user": "Can I just talk to a real person?",
          "expect": {
            "noBooking": true,
            "replyMatches": "agent|team|someone|person|call"
          }
        }
      ]
    }
  ]
}
