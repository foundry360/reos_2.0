# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Skip Twilio signature verification in local dev
TWILIO_SKIP_SIGNATURE_VERIFY=true

# Supabase — see docs/SETUP.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Connect splits (optional — GHL payments stay separate)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Meta — admin portal connects Messenger / Instagram per tenant
META_APP_ID=
META_APP_SECRET=

# Google — admin portal connects Gmail / Calendar per tenant
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypt platform integration secrets saved from /admin/integrations (64-char hex recommended)
PLATFORM_SECRETS_ENCRYPTION_KEY=

# GoHighLevel — Closed Won workflow webhook (header: x-reos-webhook-secret)
GHL_WEBHOOK_SECRET=

# Vercel Cron — secures /api/cron/* routes (Authorization: Bearer …)
CRON_SECRET=
